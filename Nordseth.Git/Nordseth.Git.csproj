<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net8.0;net10.0</TargetFrameworks>
		<PackageId>Nordseth.Git</PackageId>
		<MinVerMinimumMajorMinor>2.0</MinVerMinimumMajorMinor>
		<RepositoryUrl>https://github.com/nordseth/Nordseth-Git</RepositoryUrl>
		<PackageProjectUrl>https://github.com/nordseth/Nordseth-Git</PackageProjectUrl>
		<Authors>Nordseth</Authors>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="MinVer" Version="8.0.0">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
	</ItemGroup>

</Project>
